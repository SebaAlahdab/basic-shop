<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav class="header-bar">
        <ul class="header-bar-ul">
            <li class="header-bar-li">
                <!-- <a href="/admin/add-product" class="add-product-page">Add product</a> -->
                 <a href="/log-in" class="login-page"> log in </a>
            </li>
            <li> <a href="/products" class="products-page">products </a> </li>
            <li> <a href="/" class="index-page">main</a></li>
            <li> <a href="/cart" class="cart-page">cart </a></li>
            <li> <a href="/checkout" class="checkout-page">checkout </a></li>
            <!-- <li> <a href="admin/admin-products" class="admin-product-page"> admin products </a></li> -->
        </ul>
    </nav>
    <main>
        <div class="products-grid">

<% if (prods && prods.length > 0) { %>
    <% for (let cartItem of prods) { %>
        <% if (cartItem.product) { %>
            <div class="product-card">
                <!-- Image -->
                <img src="<%= cartItem.product.imgurl %>" alt="<%= cartItem.product.title %>">
                
                <!-- Title & Price -->
                <h2><%= cartItem.product.title %></h2>
                <p>Price: $<%= cartItem.product.price %></p>
                
                <!-- Quantity -->
                <p class="product-quantity">Quantity: <%= cartItem.quantity %></p>
                
                <!-- Delete Form -->
                <form action="/delete-from-cart" method="POST">
                    <input type="hidden" name="productid" value="<%= cartItem.product._id %>">
                    <input type="hidden" name="product-price" value="<%= cartItem.product.price %>">
                    <button class="btn" type="submit">Delete</button>
                </form>
            </div>
        <% } %>
    <% } %>
    <h3>Total Price: $<%= totalPrice %></h3>
<% } else { %>
    <h1>No Products in Cart!</h1>
<% } %>
    </main>
</body>
</html>