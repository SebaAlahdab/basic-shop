<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
     <% if (isauthenticated) { %>
    <nav class="header-bar">
        <ul class="header-bar-ul">
            <li><form action="/log-out" method="post"><button type="submit" class="btn">log-out</button></form></li>
            <li class="header-bar-li">
                <a href="/admin/add-product" class="add-product-page">Add product</a>
            </li>
            <li> <a href="/product-detail" class="product-detail-page">product details </a> </li>
            <li> <a href="/" class="index-page">main</a></li>
            <li> <a href="/cart" class="cart-page">cart </a></li>
            <li> <a href="/checkout" class="checkout-page">checkout </a></li>
        </ul>
    </nav>
    <main>
        <div class="products-grid">

        <% if (prods && prods.length > 0) { %>
                <% for (let product of prods) { %>
                    <div class="product-card">
                        <p class="product-title"><%= product.title %></p>
                        <img src="<%= product.imgurl%>" alt="<%= product.title%>">
                        <p class="product-price"><%= product.price%>$</p>
                        <p class="product-description"> <%= product.description%></p>
                                        <div class="button-group">
                        <form action="/admin/edit-product/<%= product._id %>" method="get">
                            <input type="hidden" name="productid" value="<%= product._id %>">
                            <button class="btn edit-btn" type="submit">Edit</button>
                        </form>
                        <form action="/admin/delete-product" method="post">
                            <input type="hidden" name="productid" value="<%= product._id %>">
                            <input type="hidden" name="_csrf" value="<%= csrftoken %>">
                            <button class="btn delete-btn" type="submit">Delete</button>
                        </form>
                        
                    </div>
                    </div>
                <% }; %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <p>No products available. Add your first product!</p>
            </div>
        <% } %>
    </main>
    <%} else { %>
        <h1>You are not allowed to enter this page please log in </h1>
        
        <% }%>
    
</body>
</html>