<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>
    <link rel="stylesheet" href="/css/add-product.css">
</head>
<body>
     <% if (isauthenticated) { %>
    <div class="form-control">
        <h1>Edit Product</h1><br>
        
        <% if (product) { %>
            <form action="/admin/edit-product" method="post">
                <!-- Product ID (hidden) -->
                     <input type="hidden" name="productid" value="<%= product._id %>">
                    <input type="text" name="title" id="title" value="<%= product.title %>" required>
                    <input type="text" name="imgurl" id="imgurl" value="<%= product.imgurl %>">
                    <input type="number" name="price" id="price" step="0.01" value="<%= product.price %>" required>
                    <textarea name="description" id="description" rows="4"><%= product.description %></textarea>
                    <input type="hidden" name="_csrf" value="<%= csrftoken %>">
                    <button type="submit" class="btn">Save Changes</button>

            </form>
        <% } else { %>
            <div class="error-message">
                <p>Product not found!</p><br>
                <a href="/admin/admin-products" class="btn">Back to Products</a>
            </div>
        <% } %>
    </div>
    <%} %>
</body>
</html>